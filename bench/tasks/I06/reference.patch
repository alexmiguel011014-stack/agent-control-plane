diff --git a/src/format-result.mjs b/src/format-result.mjs
--- a/src/format-result.mjs
+++ b/src/format-result.mjs
@@ -1,3 +1,20 @@
 export function formatResult(value) {
-  return JSON.stringify(value);
+  const fallback = {
+    schemaVersion: 1,
+    error: {
+      code: 'INVALID_RESULT',
+      message: 'Result is not JSON serializable',
+    },
+  };
+  try {
+    const output = JSON.stringify(value);
+    if (output === undefined) return JSON.stringify(fallback);
+    const parsed = JSON.parse(output);
+    if (value?.schemaVersion === 1 && !Object.hasOwn(parsed, 'result')) {
+      return JSON.stringify(fallback);
+    }
+    return output;
+  } catch {
+    return JSON.stringify(fallback);
+  }
 }
