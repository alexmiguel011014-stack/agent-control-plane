{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noControlCharactersInRegex": "warn",
        "noImplicitAnyLet": "warn"
      }
    }
  },
  "files": {
    "ignoreUnknown": true
  }
}
